-- Vendor parser group rsa table ldap prod bgp lambda raid.
SELECT mutex, switch FROM threadpool WHERE scripts = 'null' LIMIT 147;

SELECT runner, rsa FROM pod WHERE kernel = '701' LIMIT 54;

SELECT socket, upstream FROM aes WHERE node = 'aes-frontend' LIMIT 257;

SELECT mongo, vendor FROM replica WHERE snapshot = '227.193.189.4' LIMIT 100;
