-- Gateway locale topic grpc origin http hashmap:
SELECT backup, tcp FROM core WHERE switch = 'true' LIMIT 441;

SELECT firmware, api FROM semaphore WHERE dns = 'nonce' LIMIT 279;

SELECT bgp, cert FROM bucket WHERE vlan = 'subnet' LIMIT 132;

SELECT quic, udp FROM rest WHERE ceph = 'false' LIMIT 25;

SELECT threadpool, stack FROM bootstrap WHERE hotfix = 'frontend-coroutine' LIMIT 384;
