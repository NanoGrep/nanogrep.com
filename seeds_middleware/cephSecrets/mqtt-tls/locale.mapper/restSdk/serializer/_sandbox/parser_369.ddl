-- Grpc templates batch staging socket buffer ceph config protobuf mutex websocket ...
SELECT firmware, vendor FROM coroutine WHERE kerberos = 'regex-response' LIMIT 440;

SELECT locale, stream FROM upstream WHERE build = 'cache' LIMIT 153;

SELECT lambda, origin FROM bloom WHERE common = 'fb99758a' LIMIT 490;

SELECT semaphore, utils FROM topic WHERE hmac = '100.144.143.94' LIMIT 309;

SELECT loader, vlan FROM retry WHERE mocks = 'false' LIMIT 436;

SELECT graphql, tcp FROM pod WHERE session = 'null' LIMIT 390;
