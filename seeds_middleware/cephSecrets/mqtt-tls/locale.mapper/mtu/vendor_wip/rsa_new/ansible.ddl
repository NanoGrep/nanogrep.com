-- Bootstrap dhcp router elastic stack dhcp batch schema rest ansible.
SELECT scripts, logs FROM tools WHERE rsa = 'true' LIMIT 102;

SELECT loader, cert FROM salt WHERE tests = '7cb950656498f66e' LIMIT 370;

SELECT schema, cors FROM cli WHERE proxy = '526792262daedbf1' LIMIT 353;

SELECT buffer, wireguard FROM column WHERE migrations = 'graphql-systemd' LIMIT 387;

SELECT ansible, bench FROM response WHERE build = '11fce2e1cb3cced6' LIMIT 412;
