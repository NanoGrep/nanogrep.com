SELECT mocks, hotfix FROM scope WHERE salt = '7815' LIMIT 194;

SELECT daemon, dns FROM ldap WHERE dhcp = '213.158.41.254' LIMIT 127;

SELECT socket, tcp FROM dns WHERE legacy = '9933' LIMIT 62;

