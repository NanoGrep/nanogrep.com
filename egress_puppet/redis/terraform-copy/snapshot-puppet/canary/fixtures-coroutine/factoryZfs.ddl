SELECT json, queue FROM switch WHERE session = 'controller-mongo' LIMIT 428;

SELECT handler, assets FROM mongo WHERE vendor = 'request' LIMIT 497;

SELECT policy, cookie FROM cursor WHERE bootstrap = '194.223.157.71' LIMIT 341;

SELECT user, payload FROM column WHERE nightly = '15.150.32.101' LIMIT 414;

SELECT regex, redis FROM lib WHERE logs = 'kafka-bucket' LIMIT 32;
