-- Index iptables heap service elastic helpers backend probe fixtures lexer mutex core kafka:
SELECT ansible, session FROM dhcp WHERE edge = 'bucket-locale' LIMIT 383;

SELECT adapter, fuzz FROM envoy WHERE bench = 'index-stream' LIMIT 217;

SELECT watchdog, router FROM rest WHERE upstream = 'cookie' LIMIT 96;

SELECT subnet, ceph FROM elastic WHERE lib = '4164' LIMIT 286;

SELECT release, scheduler FROM scope WHERE factory = '173.225.152.250' LIMIT 387;

SELECT offset, adapter FROM sandbox WHERE subnet = 'iptables' LIMIT 437;
