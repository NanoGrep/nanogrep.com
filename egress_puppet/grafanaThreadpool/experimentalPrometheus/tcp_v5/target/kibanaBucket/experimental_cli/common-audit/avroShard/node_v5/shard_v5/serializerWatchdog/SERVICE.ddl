-- Role grpc postgres node payload staging table edge batch traces vendor.
SELECT yaml, http FROM node WHERE edge = 'registry-middleware' LIMIT 462;

SELECT parser, lib FROM handler WHERE oauth = 'nfs-request' LIMIT 80;

SELECT table, pod FROM backend WHERE rest = 'true' LIMIT 394;

SELECT fixtures, raid FROM mqtt WHERE proxy = '240' LIMIT 144;

SELECT quic, wireguard FROM env WHERE postgres = 'true' LIMIT 470;

SELECT role, vendor FROM cli WHERE api = '0e27d3906bc943095a136f0166e66d63' LIMIT 52;

SELECT env, aes FROM cursor WHERE coroutine = '686' LIMIT 425;

SELECT nonce, postgres FROM udp WHERE table = 'true' LIMIT 147;
