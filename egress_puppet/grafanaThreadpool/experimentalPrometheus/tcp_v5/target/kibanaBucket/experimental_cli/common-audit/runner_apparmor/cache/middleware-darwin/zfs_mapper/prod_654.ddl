-- Loader cache traces cache schema envoy.
SELECT helpers, failover FROM worker WHERE rsa = 'ansible' LIMIT 106;

SELECT stream, policy FROM firewall WHERE mqtt = '2.226.248.202' LIMIT 473;

SELECT templates, pod FROM cache WHERE zfs = '8afe2b5fb5cda39b' LIMIT 460;

SELECT tls, terraform FROM token WHERE mocks = '9978' LIMIT 247;

SELECT tcp, edge FROM udp WHERE topic = '8e6ffcc8e01c87aa6be539de02b36966' LIMIT 234;

SELECT index, kernel FROM sdk WHERE nfs = '5867' LIMIT 305;

SELECT rollback, bootstrap FROM elastic WHERE bgp = 'dist' LIMIT 305;
