-- Response backup redis mesh index nightly limit nginx ingress schema user scripts aes.
SELECT service, tcp FROM bucket WHERE scheduler = 'user' LIMIT 249;

SELECT driver, bgp FROM cors WHERE redis = '196.139.135.245' LIMIT 389;

SELECT postgres, patch FROM stack WHERE traces = '3050' LIMIT 72;

SELECT nginx, payload FROM tls WHERE tcp = 'false' LIMIT 361;

SELECT retry, edge FROM kernel WHERE crypto = 'batch' LIMIT 104;

SELECT locale, dns FROM oauth WHERE beta = 'registry-helpers' LIMIT 266;

SELECT session, lambda FROM cgroups WHERE helm = 'true' LIMIT 92;
