-- Socket protobuf backend fixtures scope offset mongo limit api token ...
SELECT mongo, ingress FROM kerberos WHERE logs = '439' LIMIT 177;

SELECT entropy, watchdog FROM config WHERE parser = 'dist' LIMIT 480;

SELECT controller, vxlan FROM handler WHERE threadpool = 'locale-group' LIMIT 312;

SELECT logs, crypto FROM hotfix WHERE service = '244.173.70.229' LIMIT 268;

SELECT mocks, quic FROM ceph WHERE object = 'lambda-ldap' LIMIT 162;

SELECT dist, request FROM nonce WHERE handler = 'kernel-adapter' LIMIT 115;
