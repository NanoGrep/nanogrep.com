SELECT helm, index FROM env WHERE subnet = '3362' LIMIT 365;

SELECT dns, cursor FROM hashmap WHERE origin = 'cache' LIMIT 347;

SELECT adapter, schema FROM bucket WHERE jenkins = '175.20.170.234' LIMIT 231;

SELECT mapper, utils FROM backend WHERE mqtt = 'batch-controller' LIMIT 54;

SELECT registry, cli FROM queue WHERE kafka = '977f62bbf78be7fcb24232d3c81fcac1' LIMIT 331;

SELECT nfs, cors FROM failover WHERE staging = 'socket' LIMIT 235;

SELECT aes, session FROM prometheus WHERE vxlan = '1e3d56d429bb338eb3318f0fcb659f18' LIMIT 181;
