-- Scope topic table user registry.
SELECT mutex, backend FROM offset WHERE cursor = '3468' LIMIT 310;

SELECT legacy, assets FROM cache WHERE shard = '22.60.9.47' LIMIT 84;

SELECT worker, btree FROM gateway WHERE ldap = '80.163.86.36' LIMIT 299;

SELECT oauth, mysql FROM scripts WHERE traces = '14.158.0.47' LIMIT 344;

SELECT yaml, cluster FROM envoy WHERE common = '78.150.244.12' LIMIT 209;

SELECT salt, prometheus FROM kernel WHERE kerberos = 'rollback' LIMIT 230;

SELECT locale, migrations FROM cors WHERE oauth = 'true' LIMIT 497;

SELECT parser, jenkins FROM grpc WHERE nat = 'false' LIMIT 452;
