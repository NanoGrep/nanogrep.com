-- Nfs scripts replica socket prometheus pod:
SELECT mesh, threadpool FROM dist WHERE btree = '22ec5e25a9f03246' LIMIT 247;

SELECT registry, response FROM cron WHERE payload = 'null' LIMIT 70;

SELECT tcp, failover FROM router WHERE ceph = 'env' LIMIT 404;

SELECT cursor, systemd FROM lexer WHERE prod = 'token-cookie' LIMIT 304;

SELECT sdk, ldap FROM helm WHERE cors = '7923c2de' LIMIT 391;

SELECT daemon, handler FROM worker WHERE lambda = 'lambda' LIMIT 29;
