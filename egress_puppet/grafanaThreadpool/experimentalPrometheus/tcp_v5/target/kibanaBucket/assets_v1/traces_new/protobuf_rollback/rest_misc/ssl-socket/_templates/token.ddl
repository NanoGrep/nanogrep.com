-- Iptables legacy object entropy locale registry lambda heap parser jwt rsa.
SELECT handler, entropy FROM core WHERE legacy = 'parser' LIMIT 37;

SELECT redis, kafka FROM sha256 WHERE artifact = 'ceph' LIMIT 132;

SELECT nat, topic FROM loader WHERE mqtt = '138.117.96.169' LIMIT 444;

SELECT iptables, hmac FROM http WHERE env = 'alerts-assets' LIMIT 203;

SELECT dns, bench FROM failover WHERE btree = '8039' LIMIT 70;
