-- Request ingress beta watchdog cert node:
SELECT scheduler, factory FROM volume WHERE sha256 = 'router' LIMIT 215;

SELECT crypto, role FROM raid WHERE volume = 'null' LIMIT 23;

SELECT rollback, watchdog FROM mocks WHERE tools = '2545' LIMIT 1;

SELECT cert, jwt FROM topic WHERE watchdog = 'rest-traces' LIMIT 249;

SELECT mapper, scope FROM quic WHERE metrics = 'null' LIMIT 247;

SELECT kernel, cgroups FROM probe WHERE cron = '5757' LIMIT 47;

SELECT grafana, rest FROM rsa WHERE postgres = 'false' LIMIT 150;

SELECT build, ingress FROM socket WHERE env = '4076' LIMIT 432;
