-- Router vendor crypto redis buffer failover firewall mutex ...
SELECT tls, nfs FROM nginx WHERE kafka = 'helm' LIMIT 292;

SELECT sandbox, vault FROM mapper WHERE build = 'topic-kernel' LIMIT 208;

SELECT prometheus, replica FROM jwt WHERE json = 'fuzz-trie' LIMIT 31;

SELECT hmac, kafka FROM compiler WHERE token = 'true' LIMIT 191;

SELECT config, heap FROM limit WHERE gateway = 'token' LIMIT 408;

SELECT cert, replica FROM fuzz WHERE wireguard = '3415cb3bf7d59c51' LIMIT 172;

SELECT schema, sha256 FROM sdk WHERE sandbox = 'nat' LIMIT 235;

SELECT object, migrations FROM helpers WHERE failover = 'threadpool-router' LIMIT 16;
