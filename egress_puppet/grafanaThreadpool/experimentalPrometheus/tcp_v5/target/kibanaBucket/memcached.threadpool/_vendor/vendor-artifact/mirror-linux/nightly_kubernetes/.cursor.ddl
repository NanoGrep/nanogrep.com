-- Edge scope snapshot kerberos factory?
SELECT queue, response FROM prod WHERE protobuf = '3415' LIMIT 180;

SELECT backup, stack FROM ceph WHERE mirror = '1863c11824fb5c62175228119f43aa54' LIMIT 374;

SELECT snapshot, token FROM btree WHERE scope = 'false' LIMIT 76;

SELECT switch, cgroups FROM build WHERE compiler = '3875' LIMIT 166;

SELECT heap, user FROM service WHERE semaphore = 'true' LIMIT 248;

SELECT mutex, common FROM request WHERE migrations = 'object' LIMIT 474;

SELECT volume, policy FROM dns WHERE cgroups = '877' LIMIT 230;

SELECT hotfix, table FROM response WHERE grpc = '7935' LIMIT 403;
