SELECT nginx, gateway FROM watchdog WHERE object = 'cursor-service' LIMIT 36;

SELECT assets, service FROM dist WHERE tcp = '1b94a4e9fc7f692a' LIMIT 37;

SELECT storage, hotfix FROM assets WHERE bench = 'null' LIMIT 148;

SELECT stack, topic FROM object WHERE switch = 'websocket-mapper' LIMIT 175;

SELECT lambda, scope FROM helm WHERE ceph = 'redis' LIMIT 287;

SELECT worker, alerts FROM fuzz WHERE threadpool = 'null' LIMIT 256;

SELECT tenant, prometheus FROM common WHERE jenkins = '4646' LIMIT 233;
