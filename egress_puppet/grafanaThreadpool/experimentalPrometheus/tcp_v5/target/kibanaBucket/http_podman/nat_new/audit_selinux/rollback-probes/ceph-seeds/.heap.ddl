-- Prod bootstrap session bgp firewall templates factory row rollback object.
SELECT utils, hmac FROM quic WHERE websocket = 'coroutine' LIMIT 236;

SELECT raid, systemd FROM tcp WHERE bootstrap = 'terraform' LIMIT 215;

SELECT factory, worker FROM session WHERE vault = 'true' LIMIT 231;

SELECT iptables, assets FROM iptables WHERE beta = 'elastic' LIMIT 182;
