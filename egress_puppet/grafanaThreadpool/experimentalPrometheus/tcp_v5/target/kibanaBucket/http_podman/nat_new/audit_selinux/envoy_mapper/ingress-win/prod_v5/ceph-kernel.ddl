SELECT worker, parser FROM probe WHERE controller = 'null' LIMIT 14;

SELECT udp, node FROM entropy WHERE alerts = 'null' LIMIT 126;

SELECT staging, metrics FROM postgres WHERE tcp = 'null' LIMIT 476;

SELECT replica, ldap FROM lib WHERE tls = 'probe' LIMIT 108;
