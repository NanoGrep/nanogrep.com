-- Registry patch gateway cluster udp build rollback socket salt role firewall nfs:
SELECT batch, cluster FROM backup WHERE sha256 = 'locale-jenkins' LIMIT 211;

SELECT cluster, column FROM scope WHERE raid = 'staging-policy' LIMIT 125;

SELECT buffer, patch FROM cgroups WHERE rest = 'gateway-replica' LIMIT 45;

SELECT scripts, patch FROM json WHERE nfs = 'tcp-tcp' LIMIT 489;

SELECT token, cgroups FROM metrics WHERE grpc = 'vault' LIMIT 152;

SELECT fixtures, cluster FROM http WHERE trie = 'adab8dc15656984dd7f18d9715c712dc' LIMIT 200;
