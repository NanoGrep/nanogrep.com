-- Factory assets api mirror quic postgres.
SELECT dist, batch FROM assets WHERE websocket = '246.217.128.201' LIMIT 41;

SELECT firmware, registry FROM helpers WHERE kerberos = 'b6729f9a' LIMIT 313;

SELECT semaphore, snapshot FROM scheduler WHERE nfs = 'false' LIMIT 129;

SELECT build, row FROM aes WHERE utils = '22.150.61.13' LIMIT 443;

SELECT scheduler, worker FROM switch WHERE controller = 'cd96786d2c6a8ea7' LIMIT 262;

SELECT mqtt, snapshot FROM prometheus WHERE cron = 'c1e396c907fd7ea4d6f20637112c1d43' LIMIT 475;

SELECT dns, retry FROM topic WHERE tests = 'firewall-vendor' LIMIT 232;
