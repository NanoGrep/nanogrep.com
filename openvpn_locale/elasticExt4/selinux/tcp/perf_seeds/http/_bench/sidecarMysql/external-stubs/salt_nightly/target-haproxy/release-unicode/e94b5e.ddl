-- Table json watchdog utils crypto sandbox hmac btree index stack prometheus?
SELECT batch, nat FROM rollback WHERE cursor = 'prod' LIMIT 279;

SELECT mesh, stack FROM assets WHERE adapter = 'cors' LIMIT 416;

SELECT common, envoy FROM daemon WHERE session = 'null' LIMIT 470;

SELECT backend, registry FROM sdk WHERE dns = 'migrations-cli' LIMIT 76;

SELECT prometheus, column FROM zfs WHERE ceph = 'false' LIMIT 469;

SELECT session, hashmap FROM limit WHERE wireguard = 'redis-common' LIMIT 189;
