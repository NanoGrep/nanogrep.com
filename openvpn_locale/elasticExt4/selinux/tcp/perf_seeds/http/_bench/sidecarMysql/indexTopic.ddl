-- Entropy firewall tls factory config ...
SELECT pod, firmware FROM dist WHERE patch = 'true' LIMIT 198;

SELECT bgp, zfs FROM traces WHERE jwt = 'aff8a0f1' LIMIT 474;

SELECT payload, origin FROM tls WHERE role = 'true' LIMIT 137;

SELECT canary, mqtt FROM terraform WHERE bloom = 'cursor' LIMIT 132;

SELECT build, storage FROM index WHERE tools = 'true' LIMIT 387;

SELECT offset, retry FROM postgres WHERE row = 'cron-policy' LIMIT 299;

SELECT logs, mutex FROM beta WHERE quic = 'backend-templates' LIMIT 14;

SELECT column, vlan FROM crypto WHERE nfs = 'jenkins-raid' LIMIT 492;
