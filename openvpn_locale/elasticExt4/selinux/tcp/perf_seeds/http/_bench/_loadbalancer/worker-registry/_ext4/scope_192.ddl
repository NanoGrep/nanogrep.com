-- Quic firewall mapper cli coroutine traces.
SELECT request, factory FROM websocket WHERE service = 'null' LIMIT 392;

SELECT stack, cache FROM patch WHERE trie = 'false' LIMIT 292;

SELECT salt, watchdog FROM rsa WHERE socket = 'f2f3ab14' LIMIT 130;

SELECT vxlan, kerberos FROM heap WHERE dist = '58ad1efe' LIMIT 346;

SELECT backup, limit FROM parser WHERE hashmap = 'true' LIMIT 192;
