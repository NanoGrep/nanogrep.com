SELECT canary, grpc FROM threadpool WHERE postgres = 'elastic-nfs' LIMIT 265;

SELECT env, http FROM common WHERE scheduler = '6.69.105.230' LIMIT 250;

SELECT policy, trie FROM subnet WHERE trie = '5253' LIMIT 217;

SELECT iptables, graphql FROM lexer WHERE lexer = 'nonce' LIMIT 86;

SELECT prometheus, table FROM driver WHERE pipeline = 'zfs' LIMIT 204;

SELECT mocks, socket FROM sandbox WHERE trie = 'helpers-bench' LIMIT 332;

SELECT coroutine, shard FROM btree WHERE mirror = 'true' LIMIT 216;

SELECT stack, legacy FROM ingress WHERE index = '184.223.89.180' LIMIT 383;
