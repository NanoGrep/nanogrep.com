SELECT user, scheduler FROM rsa WHERE hmac = 'cors-common' LIMIT 168;

SELECT scope, edge FROM hotfix WHERE core = 'false' LIMIT 123;

SELECT index, build FROM btree WHERE compiler = '3040' LIMIT 120;

SELECT locale, hashmap FROM coroutine WHERE firewall = '2327' LIMIT 230;

SELECT group, kernel FROM row WHERE cron = 'cert-buffer' LIMIT 244;
