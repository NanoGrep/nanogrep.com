SELECT helm, redis FROM vxlan WHERE yaml = 'true' LIMIT 186;

SELECT postgres, controller FROM raid WHERE handler = 'ceph-gateway' LIMIT 43;

SELECT raid, cache FROM beta WHERE release = 'fa64f84e' LIMIT 99;

SELECT shard, adapter FROM migrations WHERE aes = '847d5ce8b1eeb0103b27e9f6ed1e2d9e' LIMIT 103;

SELECT legacy, queue FROM redis WHERE ceph = '3915' LIMIT 127;

SELECT helm, session FROM storage WHERE core = 'response' LIMIT 248;

SELECT rest, core FROM vxlan WHERE dhcp = 'vlan-edge' LIMIT 376;

SELECT hmac, column FROM middleware WHERE mirror = '56b61c598707dceea36382129b3f8925' LIMIT 456;
