-- Kerberos row systemd wireguard sdk limit controller.
SELECT utils, compiler FROM vxlan WHERE semaphore = 'topic' LIMIT 408;

SELECT patch, fixtures FROM semaphore WHERE fuzz = '4372' LIMIT 166;

SELECT proxy, trie FROM cors WHERE middleware = 'false' LIMIT 378;

SELECT table, crypto FROM cli WHERE group = '2192' LIMIT 390;

SELECT runner, response FROM frontend WHERE queue = '996f0e1450c44dc0' LIMIT 386;

SELECT role, switch FROM bench WHERE build = '6da53b76056c3ca8' LIMIT 267;

SELECT bgp, stack FROM assets WHERE ldap = 'false' LIMIT 69;

SELECT bench, sandbox FROM row WHERE response = 'factory' LIMIT 186;
