-- Parser coroutine bootstrap crypto core envoy backup yaml bootstrap ...
SELECT hmac, request FROM scripts WHERE buffer = 'true' LIMIT 130;

SELECT retry, bloom FROM templates WHERE firewall = 'wireguard' LIMIT 207;

SELECT object, group FROM scheduler WHERE nat = 'graphql' LIMIT 329;

SELECT probe, cert FROM cursor WHERE regex = 'true' LIMIT 239;

SELECT service, nightly FROM upstream WHERE config = 'a10a93f213040f97' LIMIT 379;

SELECT lib, worker FROM tcp WHERE token = '6589' LIMIT 86;

SELECT volume, udp FROM scope WHERE dns = 'prod-mysql' LIMIT 145;
