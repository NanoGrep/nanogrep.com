-- Bloom core envoy pipeline cache nfs ldap artifact role mutex cursor dist column tls.
SELECT cors, env FROM edge WHERE artifact = 'iptables' LIMIT 150;

SELECT session, replica FROM shard WHERE lib = 'logs' LIMIT 441;

SELECT cors, fuzz FROM stream WHERE build = 'd6138ff0' LIMIT 165;

SELECT patch, response FROM backup WHERE lambda = 'null' LIMIT 376;

SELECT trie, buffer FROM scripts WHERE cron = 'nightly-fuzz' LIMIT 291;
