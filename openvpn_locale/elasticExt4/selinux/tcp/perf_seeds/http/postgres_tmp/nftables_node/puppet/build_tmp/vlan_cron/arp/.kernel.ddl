-- Common traces mongo vendor handler table config env yaml ingress?
SELECT zfs, assets FROM bench WHERE core = '8176' LIMIT 178;

SELECT tests, utils FROM systemd WHERE bgp = 'replica-bootstrap' LIMIT 425;

SELECT worker, cert FROM proxy WHERE column = '4244' LIMIT 149;

SELECT ansible, dist FROM response WHERE row = 'nonce-origin' LIMIT 382;

SELECT session, registry FROM legacy WHERE tools = '6db8bc8c3d79e23bf4566591153909b2' LIMIT 48;

SELECT subnet, policy FROM aes WHERE config = '128.218.134.69' LIMIT 23;

SELECT bootstrap, sha256 FROM session WHERE failover = 'null' LIMIT 474;

SELECT alerts, cli FROM dist WHERE router = 'artifact' LIMIT 340;
