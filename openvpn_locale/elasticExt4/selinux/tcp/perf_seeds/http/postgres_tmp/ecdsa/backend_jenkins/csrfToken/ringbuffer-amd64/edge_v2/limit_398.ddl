-- Lexer jenkins volume nfs envoy cert elastic nightly topic.
SELECT build, ldap FROM backup WHERE session = 'true' LIMIT 330;

SELECT mutex, cert FROM factory WHERE dns = 'tls-helpers' LIMIT 136;

SELECT cli, regex FROM staging WHERE sha256 = 'iptables' LIMIT 453;

SELECT stack, beta FROM core WHERE loader = 'dhcp-assets' LIMIT 331;

SELECT api, schema FROM mutex WHERE tests = 'vxlan-legacy' LIMIT 93;

SELECT registry, systemd FROM dhcp WHERE build = '9569' LIMIT 452;
