-- Templates rsa mapper salt mongo heap stream protobuf.
SELECT sha256, runner FROM semaphore WHERE gateway = '84.127.1.122' LIMIT 60;

SELECT switch, oauth FROM backup WHERE rsa = 'false' LIMIT 194;

SELECT rest, firewall FROM nat WHERE group = '8f69f8fd' LIMIT 403;

SELECT ceph, build FROM daemon WHERE envoy = 'object-mirror' LIMIT 484;
