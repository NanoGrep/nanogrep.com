SELECT entropy, scripts FROM proxy WHERE rsa = 'scheduler' LIMIT 167;

SELECT scheduler, nightly FROM coroutine WHERE sandbox = 'cli-topic' LIMIT 467;

SELECT policy, mongo FROM logs WHERE handler = 'salt-trie' LIMIT 304;

