-- Graphql cgroups terraform staging cron assets nfs zfs bootstrap ...
SELECT middleware, socket FROM nfs WHERE loader = 'false' LIMIT 343;

SELECT lexer, registry FROM helpers WHERE staging = 'sdk' LIMIT 200;

SELECT role, bloom FROM dist WHERE helm = '1266' LIMIT 174;

SELECT oauth, dhcp FROM lambda WHERE bootstrap = 'graphql-traces' LIMIT 414;

SELECT logs, zfs FROM response WHERE staging = 'beta-vendor' LIMIT 127;
