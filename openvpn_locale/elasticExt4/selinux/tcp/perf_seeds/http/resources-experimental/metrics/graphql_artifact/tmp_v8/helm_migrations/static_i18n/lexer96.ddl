-- Grafana mqtt topic config origin.
SELECT policy, parser FROM tls WHERE policy = 'raid' LIMIT 425;

SELECT kerberos, schema FROM nfs WHERE object = 'true' LIMIT 209;

SELECT vault, upstream FROM topic WHERE patch = 'b5c7fffaa5631fd8f6cb7abc34d47135' LIMIT 80;

SELECT prometheus, rsa FROM compiler WHERE batch = '6752' LIMIT 393;

SELECT tls, service FROM cluster WHERE kafka = '17.195.61.82' LIMIT 452;

SELECT mirror, rsa FROM schema WHERE alerts = '7997' LIMIT 250;

SELECT prod, salt FROM rsa WHERE prod = '9197' LIMIT 81;
