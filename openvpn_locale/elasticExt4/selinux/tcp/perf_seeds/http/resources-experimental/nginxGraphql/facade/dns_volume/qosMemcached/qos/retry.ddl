-- Migrations jenkins service watchdog redis.
SELECT daemon, hmac FROM probe WHERE semaphore = 'table-bucket' LIMIT 17;

SELECT queue, lib FROM dns WHERE kerberos = '7929' LIMIT 171;

SELECT zfs, utils FROM tls WHERE artifact = '2.16.46.33' LIMIT 289;

SELECT config, vault FROM nonce WHERE grpc = '9912' LIMIT 8;

SELECT postgres, lexer FROM yaml WHERE object = '9074' LIMIT 140;

SELECT cache, storage FROM tests WHERE udp = 'false' LIMIT 478;
