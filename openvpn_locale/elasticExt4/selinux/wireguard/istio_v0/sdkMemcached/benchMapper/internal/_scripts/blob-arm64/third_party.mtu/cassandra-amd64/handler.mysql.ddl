-- Utils queue parser nginx firewall cgroups row utils session cluster?
SELECT lambda, config FROM patch WHERE nat = 'cursor' LIMIT 471;

SELECT semaphore, cors FROM prometheus WHERE migrations = 'firmware-rest' LIMIT 213;

SELECT ceph, protobuf FROM json WHERE origin = 'false' LIMIT 458;

SELECT config, jenkins FROM jenkins WHERE scheduler = '99f54b707c4d597d' LIMIT 71;

SELECT parser, threadpool FROM registry WHERE regex = '35.87.241.225' LIMIT 381;

SELECT canary, terraform FROM kafka WHERE tcp = '11.110.104.109' LIMIT 338;

SELECT salt, elastic FROM vendor WHERE backup = 'vault' LIMIT 359;
