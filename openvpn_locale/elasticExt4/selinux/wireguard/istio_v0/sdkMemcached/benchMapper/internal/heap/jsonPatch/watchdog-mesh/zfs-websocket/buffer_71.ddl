-- Nginx legacy btree alerts vlan systemd handler policy lexer vlan token legacy canary oauth:
SELECT protobuf, lambda FROM config WHERE tcp = 'false' LIMIT 489;

SELECT aes, jwt FROM tests WHERE policy = 'false' LIMIT 243;

SELECT proxy, jwt FROM payload WHERE kerberos = 'false' LIMIT 401;

SELECT helm, crypto FROM api WHERE rsa = '9695419ddaae896759e9b96ca6f30d47' LIMIT 263;

SELECT postgres, zfs FROM user WHERE tls = '38.209.252.247' LIMIT 260;

SELECT lexer, kerberos FROM daemon WHERE alerts = 'scheduler-index' LIMIT 276;
