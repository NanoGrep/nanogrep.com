-- Threadpool payload assets proxy nginx failover cert storage cluster ...
SELECT cluster, tools FROM mqtt WHERE semaphore = 'false' LIMIT 450;

SELECT pod, group FROM aes WHERE daemon = 'true' LIMIT 313;

SELECT scheduler, prometheus FROM bucket WHERE kernel = 'false' LIMIT 54;

SELECT parser, cron FROM bgp WHERE mocks = 'udp-grpc' LIMIT 423;

SELECT mesh, row FROM cookie WHERE staging = 'false' LIMIT 322;

SELECT cert, runner FROM topic WHERE service = '59b89b56eca6f919395e94646750577c' LIMIT 426;

SELECT tcp, socket FROM adapter WHERE switch = 'protobuf' LIMIT 394;
