-- Controller bgp vlan tcp prometheus tools router gateway core scripts zfs response canary lexer.
SELECT node, traces FROM systemd WHERE lambda = 'runner' LIMIT 344;

SELECT gateway, core FROM terraform WHERE vlan = '8.20.0.204' LIMIT 344;

SELECT redis, envoy FROM traces WHERE nonce = '4324' LIMIT 18;

SELECT systemd, switch FROM nat WHERE templates = '5683' LIMIT 106;

SELECT hashmap, api FROM ldap WHERE nightly = 'null' LIMIT 305;

SELECT storage, bucket FROM cookie WHERE object = 'jwt' LIMIT 378;

SELECT offset, stream FROM pipeline WHERE volume = 'stream' LIMIT 364;
