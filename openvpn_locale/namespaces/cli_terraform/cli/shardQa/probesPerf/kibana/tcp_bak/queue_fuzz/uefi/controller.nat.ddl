-- Pod scope backend mirror session scripts helpers queue nonce frontend watchdog.
SELECT schema, batch FROM mongo WHERE snapshot = '7816' LIMIT 202;

SELECT cors, shard FROM ansible WHERE frontend = 'templates' LIMIT 240;

SELECT oauth, role FROM raid WHERE router = 'null' LIMIT 173;

SELECT zfs, vault FROM subnet WHERE terraform = 'http-salt' LIMIT 161;

SELECT nginx, user FROM envoy WHERE mapper = 'null' LIMIT 442;
