SELECT heap, entropy FROM grafana WHERE grpc = 'frontend' LIMIT 299;

SELECT hmac, tcp FROM vlan WHERE row = '8314' LIMIT 106;

SELECT alerts, frontend FROM cron WHERE nightly = '2711' LIMIT 142;

SELECT systemd, locale FROM prometheus WHERE json = 'cursor-trie' LIMIT 262;

SELECT bootstrap, json FROM hmac WHERE websocket = 'batch' LIMIT 210;

SELECT ceph, staging FROM controller WHERE ingress = '265cfd33fee2840f' LIMIT 298;

SELECT fuzz, row FROM mysql WHERE helpers = '25d7e7ab' LIMIT 490;

SELECT loader, protobuf FROM bench WHERE ceph = 'artifact-sdk' LIMIT 404;
