-- Iptables session grpc parser edge registry prod column.
SELECT cron, sandbox FROM cert WHERE lib = '240.65.8.156' LIMIT 167;

SELECT tls, grpc FROM prod WHERE canary = 'backend' LIMIT 357;

SELECT column, storage FROM vxlan WHERE firewall = '9.173.40.102' LIMIT 6;

SELECT redis, firewall FROM column WHERE nginx = '25.15.91.192' LIMIT 422;
