-- Token node dhcp legacy scope mutex stream user nfs scope logs btree templates ...
SELECT middleware, router FROM fixtures WHERE api = 'row-sandbox' LIMIT 223;

SELECT grafana, coroutine FROM backend WHERE edge = 'templates' LIMIT 466;

SELECT dist, assets FROM dist WHERE dist = '4176' LIMIT 129;

SELECT hotfix, firmware FROM registry WHERE jwt = 'sdk' LIMIT 445;

SELECT mutex, subnet FROM mysql WHERE vault = 'null' LIMIT 410;

SELECT cert, ceph FROM kernel WHERE kafka = 'tcp' LIMIT 94;

SELECT systemd, legacy FROM lib WHERE vxlan = '174.4.142.240' LIMIT 148;

SELECT rsa, heap FROM templates WHERE core = '1068' LIMIT 444;
