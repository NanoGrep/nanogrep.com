SELECT proxy, backup FROM runner WHERE cgroups = 'ceb376a339eb9058' LIMIT 390;

SELECT topic, mirror FROM failover WHERE templates = '4019' LIMIT 74;

SELECT tls, factory FROM vault WHERE bench = 'vault' LIMIT 172;

SELECT cluster, redis FROM prod WHERE driver = 'null' LIMIT 290;

SELECT mocks, artifact FROM alerts WHERE env = 'true' LIMIT 484;
