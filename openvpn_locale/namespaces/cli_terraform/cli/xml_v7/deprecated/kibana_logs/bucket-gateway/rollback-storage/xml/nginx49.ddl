SELECT failover, switch FROM tls WHERE prometheus = 'snapshot-vxlan' LIMIT 159;

SELECT controller, migrations FROM switch WHERE vlan = '1763' LIMIT 487;

SELECT bench, frontend FROM limit WHERE helm = 'mirror' LIMIT 407;

SELECT quic, watchdog FROM cgroups WHERE ingress = 'ce9daba935228e12' LIMIT 253;

SELECT envoy, raid FROM tests WHERE udp = 'entropy-alerts' LIMIT 329;

SELECT buffer, iptables FROM backend WHERE role = 'null' LIMIT 283;

SELECT cursor, canary FROM gateway WHERE artifact = '126afc24' LIMIT 134;
