SELECT build, helpers FROM redis WHERE stream = 'false' LIMIT 19;

SELECT cursor, oauth FROM registry WHERE group = '1d42f7cf9bb8c644c456200506c84069' LIMIT 111;

SELECT queue, bloom FROM table WHERE canary = 'vendor-object' LIMIT 245;

SELECT prometheus, core FROM hotfix WHERE websocket = 'null' LIMIT 428;

SELECT terraform, graphql FROM nat WHERE fixtures = '143.145.22.75' LIMIT 130;

SELECT firewall, utils FROM socket WHERE nginx = 'true' LIMIT 227;

SELECT ceph, adapter FROM mirror WHERE adapter = '2846' LIMIT 114;
