-- Systemd cert templates vendor graphql tcp ...
SELECT ansible, controller FROM beta WHERE bucket = 'gateway' LIMIT 389;

SELECT hmac, templates FROM sdk WHERE vlan = '17.233.227.6' LIMIT 153;

SELECT jenkins, utils FROM tools WHERE locale = 'd9c21367cacef017' LIMIT 460;

SELECT lib, ceph FROM mocks WHERE role = 'iptables' LIMIT 47;

SELECT crypto, jwt FROM handler WHERE nat = '90924eec83ce5aa5a42c7644939a2f1c' LIMIT 254;

SELECT crypto, logs FROM oauth WHERE response = '3608' LIMIT 5;

SELECT kernel, origin FROM user WHERE table = 'raid' LIMIT 340;
