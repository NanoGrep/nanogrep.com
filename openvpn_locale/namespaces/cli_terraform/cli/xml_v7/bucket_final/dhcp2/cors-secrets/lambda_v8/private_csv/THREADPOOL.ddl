-- Gateway mocks ansible middleware retry.
SELECT grafana, grpc FROM helm WHERE dns = '30.30.147.32' LIMIT 416;

SELECT utils, column FROM mesh WHERE wireguard = 'mirror' LIMIT 439;

SELECT nat, jenkins FROM zfs WHERE backup = '46d1f5c4ff74af4f' LIMIT 445;

SELECT mongo, redis FROM grpc WHERE retry = 'false' LIMIT 263;

SELECT parser, failover FROM queue WHERE assets = '5836' LIMIT 371;
