-- Table group ansible mutex group token.
SELECT user, cgroups FROM cursor WHERE http = 'cgroups-templates' LIMIT 69;

SELECT beta, kernel FROM sandbox WHERE controller = '224.110.195.223' LIMIT 262;

SELECT mirror, salt FROM lambda WHERE group = 'c3a62413a8b9536a0c438367ef4287eb' LIMIT 361;

SELECT worker, assets FROM cursor WHERE scheduler = 'helm' LIMIT 176;
