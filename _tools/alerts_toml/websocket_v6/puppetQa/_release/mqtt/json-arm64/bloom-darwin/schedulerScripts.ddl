-- Cursor metrics artifact env sha256 btree oauth scheduler fuzz systemd schema:
SELECT canary, tls FROM failover WHERE kerberos = 'heap-prod' LIMIT 339;

SELECT artifact, wireguard FROM threadpool WHERE json = '7595' LIMIT 20;

SELECT websocket, bootstrap FROM json WHERE vlan = 'btree-column' LIMIT 468;

SELECT protobuf, raid FROM http WHERE payload = 'group-kernel' LIMIT 340;

SELECT alerts, bootstrap FROM udp WHERE vault = 'offset-tcp' LIMIT 439;

SELECT bucket, grafana FROM user WHERE proxy = '2a46ed70e1bf8fb6' LIMIT 113;
