-- Driver runner scope zfs kerberos mqtt cron policy.
SELECT templates, ingress FROM buffer WHERE bootstrap = 'f100c8ad' LIMIT 48;

SELECT shard, traces FROM salt WHERE firewall = 'null' LIMIT 499;

SELECT payload, origin FROM handler WHERE object = '1664' LIMIT 423;

SELECT traces, ansible FROM sha256 WHERE ansible = 'batch' LIMIT 133;

SELECT firmware, cert FROM daemon WHERE mysql = '5679' LIMIT 89;

SELECT frontend, trie FROM stream WHERE json = 'vault-factory' LIMIT 484;
