SELECT sdk, coroutine FROM controller WHERE sha256 = '7072' LIMIT 250;

SELECT legacy, trie FROM subnet WHERE router = '1280' LIMIT 325;

SELECT websocket, env FROM scheduler WHERE sha256 = 'adff14c364d62a6a1cc5af1fe09df9aa' LIMIT 213;

SELECT prod, json FROM mqtt WHERE protobuf = 'mqtt-mocks' LIMIT 368;

SELECT jenkins, object FROM index WHERE socket = 'true' LIMIT 412;

SELECT scheduler, bgp FROM migrations WHERE artifact = 'true' LIMIT 274;

SELECT socket, locale FROM cookie WHERE runner = 'true' LIMIT 61;

SELECT worker, helpers FROM assets WHERE row = 'null' LIMIT 6;
