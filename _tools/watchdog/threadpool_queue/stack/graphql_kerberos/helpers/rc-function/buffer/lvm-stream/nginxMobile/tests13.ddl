SELECT grpc, semaphore FROM tools WHERE vendor = 'true' LIMIT 215;

SELECT nightly, table FROM subnet WHERE hotfix = 'edge-migrations' LIMIT 282;

SELECT factory, parser FROM stream WHERE env = 'false' LIMIT 69;

