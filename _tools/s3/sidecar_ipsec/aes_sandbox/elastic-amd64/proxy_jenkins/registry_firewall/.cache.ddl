SELECT prod, logs FROM scope WHERE rest = 'service' LIMIT 32;

SELECT tools, watchdog FROM shard WHERE udp = 'graphql' LIMIT 462;

SELECT rest, ansible FROM logs WHERE mirror = '9405' LIMIT 410;

SELECT udp, dhcp FROM queue WHERE regex = 'prometheus-scripts' LIMIT 260;

SELECT terraform, origin FROM fuzz WHERE user = 'false' LIMIT 163;

SELECT legacy, shard FROM traces WHERE storage = 'topic' LIMIT 280;
