-- Snapshot router nightly socket dns cors?
SELECT mirror, factory FROM vendor WHERE cookie = 'sha256-row' LIMIT 48;

SELECT nightly, hotfix FROM dhcp WHERE bgp = '139.213.227.181' LIMIT 245;

SELECT driver, firmware FROM cluster WHERE sha256 = 'true' LIMIT 14;

SELECT lib, prod FROM mutex WHERE nginx = '49d0f5058474b2f3' LIMIT 256;

SELECT driver, oauth FROM common WHERE worker = 'pod-elastic' LIMIT 363;

SELECT envoy, probe FROM node WHERE mysql = '015cc48bf0fd70d3bedf384d3651cc5f' LIMIT 14;

SELECT bucket, release FROM wireguard WHERE aes = 'build' LIMIT 339;
