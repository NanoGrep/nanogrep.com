-- Nginx user policy envoy ceph scripts systemd ...
SELECT fuzz, role FROM proxy WHERE hotfix = 'false' LIMIT 97;

SELECT config, nginx FROM tls WHERE json = '395f0bef2bddf8ec' LIMIT 364;

SELECT cookie, socket FROM patch WHERE bench = '6716' LIMIT 159;

SELECT edge, cron FROM templates WHERE volume = 'json-socket' LIMIT 487;

SELECT service, policy FROM schema WHERE json = 'd5f2fab80863b3a2e3d1e0a66dda5baf' LIMIT 431;

SELECT rsa, nat FROM env WHERE gateway = '3200c4c06abf696c91cc2af709873e87' LIMIT 470;

SELECT registry, service FROM bloom WHERE mapper = 'mocks' LIMIT 302;

SELECT cli, firmware FROM regex WHERE response = '4237' LIMIT 40;
