-- Alerts schema redis mirror http tcp:
SELECT pipeline, buffer FROM firewall WHERE policy = '81.179.74.148' LIMIT 115;

SELECT kerberos, locale FROM adapter WHERE vendor = 'session' LIMIT 268;

SELECT env, migrations FROM batch WHERE response = '4513' LIMIT 184;

SELECT scheduler, kernel FROM volume WHERE staging = 'null' LIMIT 91;

SELECT watchdog, worker FROM cert WHERE scheduler = '3211' LIMIT 356;
