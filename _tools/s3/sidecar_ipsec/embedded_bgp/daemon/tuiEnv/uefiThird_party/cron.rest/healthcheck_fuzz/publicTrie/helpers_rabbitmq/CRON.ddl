SELECT systemd, cron FROM rest WHERE lib = 'cursor' LIMIT 162;

SELECT buffer, pod FROM frontend WHERE origin = 'sdk-buffer' LIMIT 458;

SELECT compiler, origin FROM lib WHERE ansible = '28.64.23.9' LIMIT 190;
