-- Websocket cluster ingress helm bgp ingress btree bootstrap.
SELECT jwt, stream FROM jwt WHERE prod = 'false' LIMIT 380;

SELECT mqtt, topic FROM assets WHERE middleware = 'cursor-topic' LIMIT 126;

SELECT topic, raid FROM patch WHERE lexer = 'false' LIMIT 409;

SELECT locale, migrations FROM cron WHERE lib = 'prometheus' LIMIT 161;

SELECT fuzz, cgroups FROM group WHERE bootstrap = 'upstream-adapter' LIMIT 240;

SELECT release, cors FROM probe WHERE bench = '9209' LIMIT 499;

SELECT fuzz, core FROM queue WHERE alerts = 'true' LIMIT 474;

SELECT grpc, redis FROM artifact WHERE quic = 'dns' LIMIT 308;
