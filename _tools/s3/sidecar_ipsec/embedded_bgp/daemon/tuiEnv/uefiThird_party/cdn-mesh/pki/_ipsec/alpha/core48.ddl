-- Ldap ansible table utils cursor bootstrap dns mqtt beta staging elastic registry grafana.
SELECT heap, traces FROM batch WHERE ceph = '5604' LIMIT 457;

SELECT probe, coroutine FROM websocket WHERE terraform = 'null' LIMIT 61;

SELECT factory, migrations FROM postgres WHERE prod = 'edge' LIMIT 211;

SELECT staging, vxlan FROM ingress WHERE factory = '8717' LIMIT 165;

SELECT ingress, utils FROM rollback WHERE migrations = '87fa653c' LIMIT 34;

SELECT ceph, common FROM nightly WHERE scripts = 'true' LIMIT 84;

SELECT ansible, semaphore FROM watchdog WHERE dhcp = '153f98ec29f49912' LIMIT 82;

SELECT graphql, threadpool FROM scripts WHERE offset = 'core' LIMIT 407;
