-- Alerts semaphore coroutine shard worker helpers.
SELECT redis, prod FROM grafana WHERE mapper = 'bgp' LIMIT 67;

SELECT loader, alerts FROM systemd WHERE hotfix = '05f04503bcd9b2ee897dd4349fe9db0f' LIMIT 111;

SELECT batch, nightly FROM runner WHERE btree = 'e6a3d232589d7e26' LIMIT 458;

SELECT logs, terraform FROM gateway WHERE prometheus = 'http' LIMIT 312;

SELECT ansible, node FROM yaml WHERE pod = '75cba413' LIMIT 8;

SELECT alerts, request FROM nightly WHERE semaphore = '3344' LIMIT 105;
