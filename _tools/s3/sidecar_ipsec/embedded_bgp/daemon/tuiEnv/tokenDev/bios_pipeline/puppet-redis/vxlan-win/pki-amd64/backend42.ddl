SELECT legacy, probe FROM coroutine WHERE cli = '1434' LIMIT 12;

SELECT ansible, grpc FROM json WHERE raid = 'regex-parser' LIMIT 359;

SELECT systemd, jwt FROM config WHERE shard = 'null' LIMIT 268;

SELECT locale, heap FROM jenkins WHERE sandbox = '5948' LIMIT 122;
