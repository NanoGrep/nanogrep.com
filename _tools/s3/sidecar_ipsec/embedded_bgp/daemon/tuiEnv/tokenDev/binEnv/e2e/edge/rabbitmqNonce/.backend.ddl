-- Shard mqtt backup salt limit nginx trie tls bloom origin trie mapper:
SELECT handler, tenant FROM udp WHERE probe = 'c96c3a1b2f44ce6c' LIMIT 53;

SELECT sdk, handler FROM hmac WHERE lambda = 'true' LIMIT 427;

SELECT runner, mutex FROM release WHERE sha256 = 'cors-queue' LIMIT 446;

SELECT frontend, elastic FROM watchdog WHERE prod = 'true' LIMIT 24;

SELECT nginx, raid FROM sdk WHERE iptables = '8103c499' LIMIT 147;

SELECT hmac, payload FROM ceph WHERE nonce = '2591' LIMIT 236;

SELECT middleware, backup FROM trie WHERE compiler = 'edge' LIMIT 82;
