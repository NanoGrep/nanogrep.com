-- Limit coroutine alerts core middleware kafka rollback ingress wireguard parser nightly audit.
SELECT cache, queue FROM tools WHERE backend = '3205' LIMIT 400;

SELECT vendor, storage FROM role WHERE scripts = 'e9f260a7b084c9df' LIMIT 377;

SELECT assets, oauth FROM raid WHERE dns = 'false' LIMIT 381;

SELECT upstream, request FROM retry WHERE topic = 'vendor' LIMIT 105;

SELECT rsa, watchdog FROM cookie WHERE nonce = 'cache' LIMIT 104;

SELECT offset, prod FROM jwt WHERE api = 'registry-switch' LIMIT 359;

SELECT locale, jwt FROM protobuf WHERE tenant = 'nightly' LIMIT 218;

SELECT buffer, tls FROM bench WHERE helpers = 'true' LIMIT 92;
