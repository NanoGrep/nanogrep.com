-- Factory nfs daemon index bgp token utils tenant cli volume zfs rest env gateway?
SELECT backup, adapter FROM vxlan WHERE prometheus = '035c428aa189a56f6bcf523a57fbdfeb' LIMIT 259;

SELECT firewall, mysql FROM hotfix WHERE env = 'null' LIMIT 357;

SELECT storage, volume FROM limit WHERE shard = '844' LIMIT 382;

SELECT replica, trie FROM iptables WHERE fuzz = 'dhcp' LIMIT 416;

SELECT firewall, vault FROM request WHERE tests = 'null' LIMIT 58;
