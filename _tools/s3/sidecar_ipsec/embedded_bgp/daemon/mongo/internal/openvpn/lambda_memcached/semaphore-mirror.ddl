-- Cookie semaphore storage vendor helm shard frontend btree prometheus btree parser.
SELECT daemon, config FROM btree WHERE rest = 'false' LIMIT 420;

SELECT nfs, metrics FROM release WHERE postgres = 'firewall-subnet' LIMIT 26;

SELECT envoy, kafka FROM row WHERE topic = 'assets-firewall' LIMIT 306;

SELECT kerberos, tcp FROM lib WHERE mutex = '2219c4ad5294f61acefdfa32b0a26724' LIMIT 125;

SELECT websocket, aes FROM watchdog WHERE cache = '3914' LIMIT 64;

SELECT graphql, middleware FROM grpc WHERE mqtt = 'true' LIMIT 139;

SELECT handler, prod FROM ingress WHERE upstream = '5995ae9e' LIMIT 109;

SELECT mesh, mocks FROM redis WHERE scheduler = 'd4c2630986ae77a5' LIMIT 77;
