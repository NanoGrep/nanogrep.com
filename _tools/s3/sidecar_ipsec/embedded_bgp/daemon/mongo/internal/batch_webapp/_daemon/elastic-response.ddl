SELECT table, utils FROM cron WHERE snapshot = 'btree-topic' LIMIT 433;

SELECT patch, alerts FROM jwt WHERE bootstrap = 'false' LIMIT 207;

SELECT cron, adapter FROM gateway WHERE crypto = '9716' LIMIT 278;

