SELECT legacy, udp FROM lib WHERE config = 'true' LIMIT 459;

SELECT cookie, ceph FROM assets WHERE worker = 'edge' LIMIT 47;

SELECT redis, factory FROM btree WHERE release = 'true' LIMIT 201;

SELECT registry, ldap FROM vault WHERE redis = 'group' LIMIT 1;

SELECT middleware, nginx FROM cluster WHERE vxlan = '138.160.192.2' LIMIT 80;

SELECT core, common FROM nat WHERE cursor = 'queue-semaphore' LIMIT 166;

SELECT cgroups, ceph FROM oauth WHERE vendor = '393' LIMIT 276;
