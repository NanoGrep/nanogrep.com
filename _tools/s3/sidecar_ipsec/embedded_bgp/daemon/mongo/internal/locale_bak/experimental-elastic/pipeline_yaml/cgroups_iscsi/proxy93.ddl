SELECT daemon, socket FROM fuzz WHERE yaml = 'false' LIMIT 233;

SELECT grpc, canary FROM policy WHERE protobuf = '8189' LIMIT 475;

SELECT hmac, retry FROM utils WHERE registry = '2216' LIMIT 278;

SELECT role, registry FROM registry WHERE bootstrap = '54607c72' LIMIT 462;

SELECT cli, staging FROM response WHERE http = '1374' LIMIT 293;

