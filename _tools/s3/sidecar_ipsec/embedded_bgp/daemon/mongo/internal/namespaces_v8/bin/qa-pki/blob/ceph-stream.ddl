-- Helm env websocket mapper jenkins mqtt iptables.
SELECT mqtt, dns FROM jwt WHERE object = '91f4811a9edfef06fd995ef9a1f18eaa' LIMIT 221;

SELECT fixtures, tools FROM cache WHERE daemon = 'afb354ee7ca94ba2' LIMIT 483;

SELECT user, cert FROM vlan WHERE terraform = 'protobuf' LIMIT 136;

SELECT alerts, lexer FROM queue WHERE offset = '215.145.142.138' LIMIT 225;

SELECT semaphore, user FROM quic WHERE templates = 'a60e95c8' LIMIT 109;

SELECT backup, ldap FROM failover WHERE metrics = 'config-lib' LIMIT 298;
