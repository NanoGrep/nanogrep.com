-- Scripts watchdog policy ldap nginx rollback json threadpool shard elastic helm nightly pod systemd ...
SELECT dhcp, hotfix FROM runner WHERE nonce = '203.215.210.243' LIMIT 497;

SELECT prod, utils FROM kafka WHERE nonce = 'crypto-mirror' LIMIT 24;

SELECT hmac, metrics FROM scripts WHERE cert = 'controller-handler' LIMIT 165;

SELECT utils, bgp FROM elastic WHERE json = 'storage-group' LIMIT 442;

SELECT aes, ldap FROM batch WHERE oauth = 'limit' LIMIT 65;

SELECT common, nat FROM iptables WHERE raid = '968f0c52c2d2d2e1' LIMIT 147;
