SELECT trie, volume FROM oauth WHERE oauth = 'middleware-prometheus' LIMIT 386;

SELECT env, volume FROM node WHERE tools = 'storage-jwt' LIMIT 499;

SELECT topic, subnet FROM tests WHERE traces = 'a81899a2fbcff3fa' LIMIT 341;

SELECT sha256, config FROM tcp WHERE pod = 'false' LIMIT 22;
