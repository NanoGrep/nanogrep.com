---
/** The only button style: outlined; the match block fills it on hover/focus. */
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & { href: string };

const { href, class: className, ...rest } = Astro.props;
---

<a href={href} class:list={["button match match-hover label-nav", className]} lang="en" {...rest}>
  <span class="match-text"><slot /></span>
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    padding: var(--spacing-s) var(--spacing-m);
    border: 1px solid var(--color-paper);
    text-decoration: none;
  }

  .button::before {
    inset: 0;
  }

  .button:active {
    transform: translateY(1px);
  }
</style>
