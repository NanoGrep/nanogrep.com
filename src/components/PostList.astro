---
import PostCard from "./PostCard.astro";
import type { Post } from "../lib/posts";

interface Props {
  posts: Post[];
  headingLevel?: "h2" | "h3";
}

const { posts, headingLevel } = Astro.props;
---

{
  posts.length > 0 ? (
    <div class="post-list" data-post-list data-fx-hide>
      {posts.map((post) => (
        <PostCard post={post} headingLevel={headingLevel} />
      ))}
    </div>
  ) : (
    <p class="post-empty" lang="en">
      No posts yet.
    </p>
  )
}

<script>
  import "../scripts/view-transitions";
</script>

<style>
  .post-empty {
    color: var(--color-muted);
  }
</style>
