---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { site } from "../data/site";
// Preloading the two Latin subsets avoids a late font swap (layout shift)
// in the navigation and the hero; the CSS references the same files.
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import geistMonoLatin from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  /** Post cover; falls back to the default card generated at build. */
  image?: ImageMetadata;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  /** Pages with no address of their own (404): no canonical, not indexed. */
  noindex?: boolean;
}

const { title, description = site.description, image, imageAlt, type = "website", publishedTime, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);

const ogImage = image
  ? new URL((await getImage({ src: image, width: 1200, format: "png" })).src, Astro.site)
  : new URL("/og-default.png", Astro.site);

const ogImageAlt = image ? (imageAlt ?? title ?? site.name) : `${site.author}, ${site.name}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="referrer" content="no-referrer" />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#000000" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<!-- The logo itself (public/ant-eater.png, untouched) doubles as the favicon. -->
<link rel="icon" href="/ant-eater.png" type="image/png" sizes="459x459" />
<link rel="apple-touch-icon" href="/ant-eater.png" />
<link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href={new URL("/rss.xml", Astro.site)} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="es_ES" />
<meta property="og:title" content={title ?? site.name} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAlt} />
{!image && <meta property="og:image:width" content="1200" />}
{!image && <meta property="og:image:height" content="630" />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? site.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />
