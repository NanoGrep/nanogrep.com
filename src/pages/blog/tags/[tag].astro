---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MotionTitle from "../../../components/MotionTitle.astro";
import PostList from "../../../components/PostList.astro";
import TagList from "../../../components/TagList.astro";
import { getPublishedPosts, getTags } from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getTags(posts);
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, tags, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag, tags, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Posts con la etiqueta ${tag}.`}>
  <header class="page">
    <div class="list-header grid-12">
      <p class="zone-index label-meta list-count" lang="en">
        <a href="/blog/" class="link-draw list-back">Blog</a>
        <span>Tag, {posts.length} {posts.length === 1 ? "post" : "posts"}</span>
      </p>
      <div class="zone-wide">
        <MotionTitle lines={[`#${tag}`]} />
        <TagList tags={tags} current={tag} />
      </div>
    </div>
  </header>
  <div class="page list-body">
    <PostList posts={posts} headingLevel="h2" />
  </div>
</BaseLayout>

<style>
  .list-header {
    row-gap: var(--spacing-l);
    padding-block: var(--spacing-3xl) var(--spacing-2xl);
    border-bottom: 1px solid var(--color-rule);
  }

  .list-count {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-xs);
    color: var(--color-faint);
    padding-top: 0.6em;
  }

  .list-back {
    color: var(--color-faint);
    text-decoration: none;
  }

  .list-back:hover {
    color: var(--color-paper);
  }

  .list-body {
    padding-top: var(--spacing-2xl);
  }
</style>
