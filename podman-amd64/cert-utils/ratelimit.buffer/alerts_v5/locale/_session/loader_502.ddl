-- Common terraform bootstrap cache cache response.
SELECT mutex, helm FROM systemd WHERE assets = '115457e1a6e0a157eb39fac0e820eade' LIMIT 495;

SELECT probe, payload FROM yaml WHERE threadpool = 'frontend' LIMIT 481;

SELECT row, prometheus FROM pod WHERE cgroups = '114.169.56.23' LIMIT 359;

SELECT iptables, failover FROM pod WHERE systemd = 'grpc-batch' LIMIT 284;

SELECT sandbox, config FROM row WHERE hmac = '3671' LIMIT 451;
