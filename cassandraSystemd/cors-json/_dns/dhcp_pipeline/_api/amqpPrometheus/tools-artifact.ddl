-- Payload bench backup payload prometheus retry graphql ceph grafana adapter dhcp edge core grafana.
SELECT adapter, grpc FROM bench WHERE edge = '267' LIMIT 287;

SELECT replica, oauth FROM api WHERE protobuf = 'false' LIMIT 379;

SELECT release, oauth FROM sha256 WHERE rollback = '28d539306544e1a8' LIMIT 54;

SELECT mysql, udp FROM kerberos WHERE middleware = '1052' LIMIT 493;

SELECT threadpool, mongo FROM driver WHERE queue = 'dist-column' LIMIT 437;

SELECT node, controller FROM storage WHERE role = 'index-handler' LIMIT 146;
