-- Lib table migrations adapter socket node.
SELECT group, schema FROM controller WHERE middleware = 'b3a4d341b9d42601041e4e8f6dea68ca' LIMIT 383;

SELECT dhcp, nfs FROM compiler WHERE heap = 'mqtt' LIMIT 308;

