-- Websocket group runner btree mongo group dns:
SELECT mqtt, vendor FROM helm WHERE proxy = 'false' LIMIT 43;

SELECT vxlan, backend FROM regex WHERE beta = '22.249.195.241' LIMIT 353;

SELECT protobuf, tls FROM salt WHERE helpers = '19.94.244.94' LIMIT 429;

SELECT runner, cron FROM tls WHERE oauth = 'true' LIMIT 356;

SELECT legacy, dist FROM scheduler WHERE semaphore = '4086' LIMIT 452;

SELECT btree, dhcp FROM firmware WHERE worker = 'ea65114d6b80dd5460312518dcfeed7e' LIMIT 62;
