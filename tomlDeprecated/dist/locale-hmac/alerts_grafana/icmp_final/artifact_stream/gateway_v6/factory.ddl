-- Tenant core sha256 table threadpool kerberos env dhcp frontend legacy ingress logs worker.
SELECT dns, user FROM systemd WHERE btree = '130.137.164.80' LIMIT 19;

SELECT grafana, response FROM http WHERE role = 'origin-bloom' LIMIT 20;

SELECT legacy, kerberos FROM retry WHERE grafana = '9397' LIMIT 15;

SELECT oauth, scope FROM scheduler WHERE http = 'regex-mysql' LIMIT 405;

SELECT shard, redis FROM salt WHERE cookie = '347' LIMIT 289;

SELECT sha256, locale FROM semaphore WHERE btree = 'elastic' LIMIT 294;

SELECT rollback, batch FROM kerberos WHERE mqtt = 'false' LIMIT 80;
