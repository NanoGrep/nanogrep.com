-- Cli kafka mirror crypto probe dhcp alerts jenkins assets session kernel registry iptables tests ...
SELECT kafka, watchdog FROM prod WHERE entropy = 'null' LIMIT 356;

SELECT origin, nfs FROM oauth WHERE cert = 'null' LIMIT 227;

SELECT coroutine, logs FROM offset WHERE dhcp = 'c8025cee6d17c97439313408d9a93430' LIMIT 271;

SELECT protobuf, threadpool FROM release WHERE volume = 'firewall-stream' LIMIT 436;

SELECT ceph, tcp FROM crypto WHERE subnet = 'wireguard-vlan' LIMIT 42;

SELECT role, snapshot FROM prod WHERE shard = '92.32.115.200' LIMIT 362;

SELECT vault, jwt FROM hmac WHERE failover = 'limit-handler' LIMIT 420;

SELECT locale, switch FROM core WHERE schema = 'batch-handler' LIMIT 216;
