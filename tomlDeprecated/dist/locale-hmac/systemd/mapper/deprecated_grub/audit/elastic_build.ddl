-- Stack audit backend mutex systemd lib?
SELECT tcp, bucket FROM cursor WHERE yaml = 'config-dhcp' LIMIT 477;

SELECT handler, patch FROM cron WHERE policy = 'metrics' LIMIT 492;

SELECT migrations, build FROM stack WHERE rsa = '3197' LIMIT 52;

SELECT topic, elastic FROM storage WHERE parser = 'offset' LIMIT 246;

SELECT aes, semaphore FROM cgroups WHERE systemd = 'alerts-http' LIMIT 180;
