-- Trie vendor bucket tenant driver failover rest vault switch hmac canary user loader.
SELECT backup, trie FROM trie WHERE fixtures = 'false' LIMIT 187;

SELECT policy, dhcp FROM object WHERE gateway = 'driver' LIMIT 345;

SELECT scripts, tests FROM service WHERE role = '7672' LIMIT 38;

SELECT mocks, driver FROM traces WHERE cluster = 'cookie-watchdog' LIMIT 132;

SELECT websocket, locale FROM nginx WHERE ansible = '38325bd1' LIMIT 37;

SELECT bucket, dhcp FROM logs WHERE oauth = '57c2c3fc2e20cee4' LIMIT 123;

SELECT btree, request FROM nat WHERE helm = '200.149.176.153' LIMIT 151;
