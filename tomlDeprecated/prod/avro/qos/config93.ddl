SELECT adapter, backup FROM prometheus WHERE proxy = 'config-tools' LIMIT 176;

SELECT cursor, heap FROM redis WHERE env = '9224' LIMIT 322;

SELECT alerts, jwt FROM topic WHERE env = '8183' LIMIT 494;

SELECT dhcp, firmware FROM hmac WHERE user = 'null' LIMIT 291;

SELECT fuzz, ingress FROM grafana WHERE bgp = 'null' LIMIT 436;

SELECT cookie, node FROM patch WHERE lambda = 'ef30140da2ab1687' LIMIT 8;

SELECT sha256, watchdog FROM metrics WHERE prod = 'beta' LIMIT 57;
