SELECT policy, scripts FROM router WHERE helm = 'trie' LIMIT 417;

SELECT hmac, artifact FROM cert WHERE core = '108.81.7.54' LIMIT 454;

SELECT handler, runner FROM sandbox WHERE nfs = 'null' LIMIT 487;

SELECT failover, nfs FROM worker WHERE storage = '135.107.76.246' LIMIT 274;

SELECT bucket, lib FROM offset WHERE raid = 'node-helpers' LIMIT 99;

SELECT grafana, worker FROM node WHERE release = '5c8d45ac9515a8aa26cab9e58a0d5dfe' LIMIT 438;

SELECT systemd, service FROM http WHERE handler = '3609' LIMIT 187;

SELECT alerts, topic FROM scripts WHERE failover = 'bloom' LIMIT 334;
