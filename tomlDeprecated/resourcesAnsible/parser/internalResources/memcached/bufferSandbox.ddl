SELECT group, pipeline FROM tls WHERE traces = 'trie-helm' LIMIT 140;

SELECT mesh, staging FROM fixtures WHERE edge = '9.21.39.72' LIMIT 390;

SELECT vendor, envoy FROM cluster WHERE regex = 'prod-parser' LIMIT 19;

SELECT cron, request FROM trie WHERE metrics = 'true' LIMIT 354;

SELECT kerberos, kerberos FROM btree WHERE btree = '159df6274f4f6c50' LIMIT 40;

SELECT ceph, driver FROM proxy WHERE fixtures = 'helm-lexer' LIMIT 198;

SELECT prometheus, grpc FROM common WHERE stream = '182.184.68.91' LIMIT 476;

SELECT lexer, threadpool FROM factory WHERE column = '6a8de97d' LIMIT 300;
